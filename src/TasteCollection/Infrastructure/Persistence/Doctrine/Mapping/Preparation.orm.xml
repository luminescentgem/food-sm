<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="App\TasteCollection\Domain\Model\Preparation" table="preparations">
        <id name="id" type="preparation_id" column="id"/>
        <field name="name" type="string" column="name" length="100"/>
        <many-to-one field="parent" target-entity="App\TasteCollection\Domain\Model\Preparation">
            <join-column name="parent_id" referenced-column-name="id" nullable="true"/>
        </many-to-one>
        <unique-constraints>
            <unique-constraint name="uniq_preparations_name" columns="name"/>
        </unique-constraints>
        <indexes>
            <index name="idx_preparations_parent" columns="parent_id"/>
        </indexes>
    </entity>
</doctrine-mapping>
